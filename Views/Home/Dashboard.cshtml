@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div><div class="text-secondary small">YOUR OVERVIEW</div><h2 class="fw-bold mb-1">Dashboard</h2><p class="text-secondary mb-0">Here is how your recorded money is looking.</p></div>
  <a asp-controller="Transactions" asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i> Add transaction</a>
</div>
<div class="row g-3 mb-4">
  <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4"><div class="text-secondary">Total income</div><div class="fs-3 fw-bold text-success mt-2">Rs. @Model.TotalIncome.ToString("N2")</div><i class="bi bi-arrow-down-left-circle text-success fs-4"></i></div></div></div>
  <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4"><div class="text-secondary">Total expenses</div><div class="fs-3 fw-bold text-danger mt-2">Rs. @Model.TotalExpenses.ToString("N2")</div><i class="bi bi-arrow-up-right-circle text-danger fs-4"></i></div></div></div>
  <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4"><div class="text-secondary">Net balance</div><div class="fs-3 fw-bold mt-2 @(Model.Balance >= 0 ? "text-primary" : "text-danger")">Rs. @Model.Balance.ToString("N2")</div><i class="bi bi-wallet2 text-primary fs-4"></i></div></div></div>
</div>
<div class="card border-0 shadow-sm rounded-4">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-center mb-3"><h5 class="fw-bold mb-0">Recent transactions</h5><a asp-controller="Transactions" asp-action="Index" class="text-success text-decoration-none">View all</a></div>
    @if (!Model.RecentTransactions.Any()) { <div class="text-center py-5"><i class="bi bi-receipt fs-1 text-secondary"></i><h5 class="mt-3">No transactions yet</h5><p class="text-secondary">Add your first income or expense to get started.</p><a asp-controller="Transactions" asp-action="Create" class="btn btn-success">Add transaction</a></div> }
    else {
      <div class="table-responsive"><table class="table align-middle"><thead class="text-secondary small"><tr><th>DETAIL</th><th>CATEGORY</th><th>DATE</th><th class="text-end">AMOUNT</th></tr></thead><tbody>
      @foreach (var item in Model.RecentTransactions) { <tr><td class="fw-semibold">@item.Title</td><td><span class="badge text-bg-light">@item.Category</span></td><td>@item.TransactionDate.ToString("dd MMM yyyy")</td><td class="text-end fw-semibold @(item.Type == "Income" ? "text-success" : "text-danger")">@(item.Type == "Income" ? "+" : "−") Rs. @item.Amount.ToString("N2")</td></tr> }
      </tbody></table></div>
    }
  </div>
</div>
