@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "Registered users";
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Registered users</h2>
        <p class="text-secondary mb-0">Accounts registered with FinTracker.</p>
    </div>
    <span class="badge text-bg-light fs-6">@Model.Count() users</span>
</div>
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-3 p-md-4">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people fs-1 text-secondary"></i>
                <h5 class="mt-3">No registered users</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="text-secondary small">
                        <tr>
                            <th>EMAIL / USERNAME</th>
                            <th>USER ID</th>
                            <th>EMAIL STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @user.Email
                                <div class="small text-secondary">@user.UserName</div>
                            </td>
                            <td><code>@user.Id</code></td>
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <span class="badge text-bg-success">Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Not confirmed</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
