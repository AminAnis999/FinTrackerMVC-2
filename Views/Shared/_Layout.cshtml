
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - FinTracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark" style="background:#14213d">
        <div class="container">

            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-wallet2 me-2"></i>FinTracker
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto ms-lg-4">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Transactions" asp-action="Index">
                                Transactions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Transactions" asp-action="Create">
                                Add transaction
                            </a>
                        </li>

                        @if (User.HasClaim("FinTrackerAdmin", "true"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Users" asp-action="Index">
                                    Users
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="d-flex align-items-center gap-3 text-white">
                        <span class="small d-none d-md-inline">@User.Identity.Name</span>

                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="btn btn-outline-light btn-sm">Sign out</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="ms-auto d-flex gap-2">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                            Log in
                        </a>

                        <a class="btn btn-success btn-sm" asp-controller="Account" asp-action="Register">
                            Create account
                        </a>
                    </div>
                }

            </div>
        </div>
    </nav>

    <main class="container py-4 py-md-5">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()

    </main>

    <footer class="border-top bg-white py-3 mt-5">
        <div class="container small text-secondary d-flex justify-content-between">
            <span>© @DateTime.Now.Year FinTracker</span>
            <span>Make every rupee count.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
