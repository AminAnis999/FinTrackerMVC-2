@model List<FinanceTransaction>
@{ ViewData["Title"] = "Transactions"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><div><h2 class="fw-bold mb-1">Transactions</h2><p class="text-secondary mb-0">Keep track of money coming in and going out.</p></div><a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i> Add new</a></div>
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-3 p-md-4">
@if (!Model.Any()) { <div class="text-center py-5"><i class="bi bi-journal-text fs-1 text-secondary"></i><h5 class="mt-3">Nothing to show yet</h5><p class="text-secondary">Your transactions will appear here.</p></div> }
else { <div class="table-responsive"><table class="table align-middle"><thead class="text-secondary small"><tr><th>DESCRIPTION</th><th>TYPE</th><th>CATEGORY</th><th>DATE</th><th>AMOUNT</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td class="fw-semibold">@item.Title@if (!string.IsNullOrWhiteSpace(item.Note)) { <div class="small text-secondary">@item.Note</div> }</td><td><span class="badge @(item.Type == "Income" ? "text-bg-success" : "text-bg-danger")">@item.Type</span></td><td>@item.Category</td><td>@item.TransactionDate.ToString("dd MMM yyyy")</td><td class="fw-semibold @(item.Type == "Income" ? "text-success" : "text-danger")">Rs. @item.Amount.ToString("N2")</td><td><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this transaction?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr> }
</tbody></table></div> }
</div></div>
